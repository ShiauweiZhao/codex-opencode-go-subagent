{
  "description": "One-shot plaintext task handoff for the OpenCode Go backed opencode_go_v4_worker.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^opencode_go_v4_worker$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/plaintext_handoff.py\" --mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged Flash assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
